module Datadog
  module AppSec
    module WAF
      module LibDDWAF
        DEFAULT_MAX_CONTAINER_SIZE: ::Integer
        DEFAULT_MAX_CONTAINER_DEPTH: ::Integer
        DEFAULT_MAX_STRING_LENGTH: ::Integer

        DDWAF_MAX_CONTAINER_SIZE: ::Integer
        DDWAF_MAX_CONTAINER_DEPTH: ::Integer
        DDWAF_MAX_STRING_LENGTH: ::Integer

        DDWAF_RUN_TIMEOUT: ::Integer

        extend ::FFI::Library

        def self.typedef: [T < ::FFI::Type, N, R, C] (T old, Symbol | ::FFI::DataConverter[N, R, C] add, ?untyped) -> T
           | (Symbol old, Symbol add, ?untyped) -> (::FFI::Type | ::FFI::Enum)
           | [X < ::FFI::DataConverter[N, R, C], N, R, C] (X old, Symbol add, ?untyped) -> ::FFI::Type::Mapped[X, N, R, C]
           | (:enum old, Array[Symbol | Integer] add, ?untyped) -> ::FFI::Enum
           | (:enum old, Symbol | ::FFI::Type add, Array[Symbol | Integer] info) -> ::FFI::Enum
           | (untyped, ::Symbol) -> void

        def self.callback: (::Symbol name, Array[::FFI::Library::ffi_lib_type] params, ::FFI::Library::ffi_lib_type ret) -> ::FFI::CallbackInfo

        def self.enum: (*(Symbol | Integer) args) -> ::FFI::Enum
                     | (Array[Symbol | Integer] values) -> ::FFI::Enum

        def self.local_os: () -> ::String
        def self.local_cpu: () -> ::String
        def self.local_version: () -> (::String | nil)
        def self.source_dir: () -> ::String
        def self.vendor_dir: () -> ::String
        def self.libddwaf_vendor_dir: () -> ::String
        def self.shared_lib_triplet: (?version: ::String?) -> ::String
        def self.libddwaf_dir: () -> ::String
        def self.shared_lib_extname: () -> ::String
        def self.shared_lib_path: () -> ::String

        # version

        def self.ddwaf_get_version: () -> ::String

        # ddwaf::object data structure

        DDWAF_OBJ_TYPE: ::FFI::Enum

        class UInt32Ptr < ::FFI::Struct[::FFI::AbstractMemory, ::Integer]
        end

        class UInt64Ptr < ::FFI::Struct[::FFI::AbstractMemory, ::Integer]
        end

        class SizeTPtr < ::FFI::Struct[::FFI::AbstractMemory, ::Integer]
        end

        class ObjectBool < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectSigned < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectUnsigned < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectFloat < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectString < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectSmallString < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectArray < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectMap < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        class ObjectValueUnion < ::FFI::Union[::FFI::AbstractMemory, untyped]
        end

        class Object < ::FFI::Union[::FFI::Pointer, untyped]
          @truncated: bool

          def truncated?: () -> bool

          def mark_truncated!: () -> bool
        end

        class ObjectKV < ::FFI::Struct[::FFI::AbstractMemory, untyped]
        end

        # allocators

        def self.ddwaf_get_default_allocator: () -> ::FFI::Pointer
        def self.ddwaf_allocator_alloc: (::FFI::Pointer, ::Integer, ::Integer) -> ::FFI::Pointer
        def self.ddwaf_allocator_free: (::FFI::Pointer, ::FFI::Pointer, ::Integer, ::Integer) -> void

        # setters

        # Object.by_ref returns an Object wrapper even for NULL; check to_ptr.null?.
        def self.ddwaf_object_set_invalid: (LibDDWAF::Object) -> LibDDWAF::Object
        def self.ddwaf_object_set_null: (LibDDWAF::Object) -> LibDDWAF::Object
        def self.ddwaf_object_set_bool: (LibDDWAF::Object, bool) -> LibDDWAF::Object
        def self.ddwaf_object_set_signed: (LibDDWAF::Object, ::Integer) -> LibDDWAF::Object
        def self.ddwaf_object_set_unsigned: (LibDDWAF::Object, ::Integer) -> LibDDWAF::Object
        def self.ddwaf_object_set_float: (LibDDWAF::Object, ::Float) -> LibDDWAF::Object

        def self.ddwaf_object_from_json: (LibDDWAF::Object, ::String | ::FFI::Pointer, ::Integer, ::FFI::Pointer) -> bool

        def self.ddwaf_object_set_string: (LibDDWAF::Object, ::String | ::FFI::Pointer, ::Integer, ::FFI::Pointer) -> LibDDWAF::Object
        def self.ddwaf_object_set_string_literal: (LibDDWAF::Object, ::FFI::Pointer, ::Integer) -> LibDDWAF::Object
        def self.ddwaf_object_set_string_nocopy: (LibDDWAF::Object, ::FFI::Pointer, ::Integer) -> LibDDWAF::Object

        def self.ddwaf_object_set_array: (LibDDWAF::Object, ::Integer, ::FFI::Pointer) -> LibDDWAF::Object
        def self.ddwaf_object_set_map: (LibDDWAF::Object, ::Integer, ::FFI::Pointer) -> LibDDWAF::Object

        def self.ddwaf_object_insert: (LibDDWAF::Object, ::FFI::Pointer) -> LibDDWAF::Object
        def self.ddwaf_object_insert_key: (LibDDWAF::Object, ::String | ::FFI::Pointer, ::Integer, ::FFI::Pointer) -> LibDDWAF::Object
        def self.ddwaf_object_insert_key_nocopy: (LibDDWAF::Object, ::FFI::Pointer, ::Integer, ::FFI::Pointer) -> LibDDWAF::Object

        # getters

        def self.ddwaf_object_get_type: (LibDDWAF::Object) -> ::Symbol
        def self.ddwaf_object_get_size: (LibDDWAF::Object) -> ::Integer
        def self.ddwaf_object_get_length: (LibDDWAF::Object) -> ::Integer
        def self.ddwaf_object_get_string: (LibDDWAF::Object, SizeTPtr?) -> ::FFI::Pointer
        def self.ddwaf_object_get_unsigned: (LibDDWAF::Object) -> ::Integer
        def self.ddwaf_object_get_signed: (LibDDWAF::Object) -> ::Integer
        def self.ddwaf_object_get_bool: (LibDDWAF::Object) -> bool
        def self.ddwaf_object_get_float: (LibDDWAF::Object) -> ::Float

        def self.ddwaf_object_at_key: (LibDDWAF::Object, ::Integer) -> LibDDWAF::Object
        def self.ddwaf_object_at_value: (LibDDWAF::Object, ::Integer) -> LibDDWAF::Object

        # destruction

        def self.ddwaf_object_destroy: (LibDDWAF::Object, ::FFI::Pointer) -> void

        # handle builder

        def self.ddwaf_builder_init: () -> ::FFI::Pointer
        def self.ddwaf_builder_destroy: (::FFI::Pointer) -> void

        def self.ddwaf_builder_add_or_update_config: (::FFI::Pointer, ::String, ::Integer, LibDDWAF::Object, LibDDWAF::Object) -> bool
        def self.ddwaf_builder_remove_config: (::FFI::Pointer, ::String, ::Integer) -> bool

        def self.ddwaf_builder_build_instance: (::FFI::Pointer) -> ::FFI::Pointer

        # main handle

        def self.ddwaf_destroy: (::FFI::Pointer) -> void

        def self.ddwaf_known_addresses: (::FFI::Pointer, UInt32Ptr) -> ::FFI::Pointer

        # updating

        DDWAF_RET_CODE: ::FFI::Enum

        # evaluation

        def self.ddwaf_context_init: (::FFI::Pointer, ::FFI::Pointer) -> ::FFI::Pointer
        def self.ddwaf_context_destroy: (::FFI::Pointer) -> void
        def self.ddwaf_context_eval: (::FFI::Pointer, Object, ::FFI::Pointer, Object, ::Integer) -> ::Symbol

        def self.ddwaf_subcontext_init: (::FFI::Pointer) -> ::FFI::Pointer
        def self.ddwaf_subcontext_destroy: (::FFI::Pointer) -> void
        def self.ddwaf_subcontext_eval: (::FFI::Pointer, Object, ::FFI::Pointer, Object, ::Integer) -> ::Symbol

        # logging

        DDWAF_LOG_LEVEL: ::FFI::Enum

        type ddwaf_log_level = ::Symbol

        # TODO: signature is as below but steep 1.1 does not yet support method/proc/block mapping
        # type ddwaf_log_cb = ^(ddwaf_log_level, ::String, ::String, ::Integer, ::FFI::Pointer, ::Integer) -> void
        type ddwaf_log_cb = ::Method | ::Proc
        def self.ddwaf_set_log_cb: (ddwaf_log_cb, ddwaf_log_level) -> bool
      end
    end
  end
end
