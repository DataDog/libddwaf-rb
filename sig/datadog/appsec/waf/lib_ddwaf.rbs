module Datadog
  module AppSec
    module WAF
      # Public surface of the C extension. Types are intentionally coarse —
      # the wrapper classes are opaque TypedData and the trampolines accept
      # pointer-as-Integer values that Steep can't usefully constrain.
      module LibDDWAF
        LIBDDWAF_LINKED_VERSION: ::String
        TRAMPOLINES: bool

        DEFAULT_MAX_CONTAINER_SIZE: ::Integer
        DEFAULT_MAX_CONTAINER_DEPTH: ::Integer
        DEFAULT_MAX_STRING_LENGTH: ::Integer
        DDWAF_MAX_CONTAINER_SIZE: ::Integer
        DDWAF_MAX_CONTAINER_DEPTH: ::Integer
        DDWAF_MAX_STRING_LENGTH: ::Integer
        DDWAF_RUN_TIMEOUT: ::Integer

        # TypedData wrapper around `ddwaf_object`. Allocated via `.new`;
        # populated by `LibDDWAF.ddwaf_object_*` setters; read via accessors.
        class Object
          def initialize: () -> void
          def type: () -> ::Symbol
          def nb_entries: () -> ::Integer
          def string_bytes: () -> ::String
          def unsigned_value: () -> ::Integer
          def signed_value: () -> ::Integer
          def bool_value: () -> bool
          def float_value: () -> ::Float
          def array_index: (::Integer i) -> Object
          def key_bytes: () -> ::String?
          def truncated?: () -> bool
          def mark_truncated!: () -> bool
          def object_ptr: () -> ::Integer
          def owned?: () -> bool
          def disown!: () -> Object
        end

        # Opaque TypedData wrappers for libddwaf lifecycle pointers. Ruby
        # callers never construct these directly; the lifecycle cfuncs below
        # produce them.
        class Handle
        end

        class Builder
        end

        class Context
        end

        # Leaf trampolines (FFX-style, ZJIT-friendly) and binary-string cfuncs.
        # All take pointer-as-Integer via `obj.object_ptr` on the caller side.
        def self?.ddwaf_get_version: () -> ::String
        def self?.ddwaf_object_invalid: (::Integer) -> ::Integer
        def self?.ddwaf_object_null: (::Integer) -> ::Integer
        def self?.ddwaf_object_string: (::Integer, ::String) -> ::Integer
        def self?.ddwaf_object_stringl: (::Integer, ::String, ::Integer) -> ::Integer
        def self?.ddwaf_object_string_from_unsigned: (::Integer, ::Integer) -> ::Integer
        def self?.ddwaf_object_string_from_signed: (::Integer, ::Integer) -> ::Integer
        def self?.ddwaf_object_unsigned: (::Integer, ::Integer) -> ::Integer
        def self?.ddwaf_object_signed: (::Integer, ::Integer) -> ::Integer
        def self?.ddwaf_object_bool: (::Integer, bool) -> ::Integer
        def self?.ddwaf_object_float: (::Integer, ::Float) -> ::Integer
        def self?.ddwaf_object_array: (::Integer) -> ::Integer
        def self?.ddwaf_object_map: (::Integer) -> ::Integer
        def self?.ddwaf_object_array_add: (::Integer, ::Integer) -> bool
        def self?.ddwaf_object_map_add: (::Integer, ::String, ::Integer) -> bool
        def self?.ddwaf_object_map_addl: (::Integer, ::String, ::Integer, ::Integer) -> bool
        def self?.ddwaf_object_size: (::Integer) -> ::Integer
        def self?.ddwaf_object_length: (::Integer) -> ::Integer
        def self?.ddwaf_object_get_unsigned: (::Integer) -> ::Integer
        def self?.ddwaf_object_get_signed: (::Integer) -> ::Integer
        def self?.ddwaf_object_get_bool: (::Integer) -> bool
        def self?.ddwaf_object_get_float: (::Integer) -> ::Float
        def self?.ddwaf_object_get_index: (::Integer, ::Integer) -> ::Integer
        def self?.ddwaf_object_type: (::Integer) -> ::Symbol

        # Lifecycle cfuncs. These produce / consume the wrapper classes above.
        def self?.ddwaf_builder_init: (::Hash[::Symbol, untyped]) -> Builder?
        def self?.ddwaf_builder_destroy: (Builder) -> nil
        def self?.ddwaf_builder_build_instance: (Builder) -> Handle?
        def self?.ddwaf_builder_add_or_update_config: (Builder, ::String, Object, Object) -> bool
        def self?.ddwaf_builder_remove_config: (Builder, ::String) -> bool
        def self?.ddwaf_destroy: (Handle) -> nil
        def self?.ddwaf_context_init: (Handle) -> Context?
        def self?.ddwaf_context_destroy: (Context) -> nil
        def self?.ddwaf_run: (Context, Object, Object, Object, ::Integer) -> ::Symbol
        def self?.ddwaf_known_addresses: (Handle) -> ::Array[::String]
      end
    end
  end
end
