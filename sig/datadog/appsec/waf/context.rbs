module Datadog
  module AppSec
    module WAF
      class Context
        @context_ptr: ::FFI::Pointer?

        def initialize: (::FFI::Pointer context_ptr) -> void

        def finalize!: () -> void

        def build_subcontext: () -> Subcontext
                            | [T] () { (Subcontext) -> T } -> T

        def eval: (::Hash[WAF::input, WAF::input] data, ?::Integer timeout) -> Result

        private

        def ensure_pointer_presence!: () -> void
      end
    end
  end
end
