module Datadog
  module AppSec
    module WAF
      class Context
        @context_ptr: ::FFI::Pointer?
        @limits: ::Hash[::Symbol, ::Integer]

        @state: :active | :failed | :finalized
        @failed: bool

        EMPTY_RESULT: {
          "events" => WAF::events,
          "actions" => WAF::actions,
          "attributes" => WAF::attributes,
          "duration" => ::Integer,
          "timeout" => bool,
          "keep" => bool
        }

        SUCCESS_RESULT_CODES: ::Array[::Symbol]

        RESULT_CODE_TO_STATUS: ::Hash[::Symbol, ::Symbol]

        def initialize: (::FFI::Pointer context_ptr, limits: ::Hash[::Symbol, ::Integer]) -> void

        def failed?: () -> bool

        def mark_failed!: () -> bool

        def finalize!: () -> void

        def build_subcontext: () -> Subcontext
                            | [T] () { (Subcontext) -> T } -> T

        def eval: (::Hash[WAF::input, WAF::input] data, ?::Integer timeout) -> Result

        private

        def ensure_active!: () -> ::FFI::Pointer

        def destroy_context!: () -> void
      end
    end
  end
end
