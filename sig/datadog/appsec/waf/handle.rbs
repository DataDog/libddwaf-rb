module Datadog
  module AppSec
    module WAF
      class Handle
        @handle_ptr: untyped

        def initialize: (untyped handle_ptr) -> void

        def finalize!: () -> void

        def build_context: () -> Context

        def known_addresses: () -> known_addresses

