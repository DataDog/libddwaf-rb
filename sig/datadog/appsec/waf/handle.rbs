module Datadog
  module AppSec
    module WAF
      class Handle
        @handle_ptr: ::FFI::Pointer
        @limits: ::Hash[::Symbol, ::Integer]

        def initialize: (::FFI::Pointer handle_ptr, limits: ::Hash[::Symbol, ::Integer]) -> void

        def finalize!: () -> void

        def build_context: () -> Context

        def known_addresses: () -> known_addresses

        private

        def ensure_pointer_presence!: () -> void
      end
    end
  end
end
