module Datadog
  module AppSec
    module WAF
      module Converter
        MAX_CONTAINER_SIZE: Integer

        MAX_CONTAINER_DEPTH: Integer

        MAX_STRING_LENGTH: Integer

        INT64_MIN: Integer

        UINT16_MAX: Integer

        UINT32_MAX: Integer

        UINT64_MAX: Integer

        def self?.ruby_to_object: (
          top val,
          ?truncate: bool,
          ?coerce: bool?
        ) -> LibDDWAF::Object

        def self?.populate_object: (
          LibDDWAF::Object object,
          top val,
          allocator: ::FFI::Pointer,
          top_obj: LibDDWAF::Object,
          ?truncate: bool,
          depth: ::Integer,
          coerce: bool?
        ) -> LibDDWAF::Object

        def self?.truncate_input_string: (::String string, top_obj: LibDDWAF::Object) -> ::String

        def self?.string_to_object: (LibDDWAF::Object object, ::String string, ::FFI::Pointer allocator, ?truncate: bool, top_obj: LibDDWAF::Object) -> LibDDWAF::Object

        def self?.container_capacity: (::Integer size, ?truncate: bool, depth: ::Integer) -> ::Integer

        def self?.object_to_ruby: (LibDDWAF::Object obj) -> WAF::opaque

        def self?.object_to_string: (LibDDWAF::Object obj) -> ::String
      end
    end
  end
end
