module Datadog
  module AppSec
    module WAF
      module Converter
        MAX_CONTAINER_SIZE: Integer

        MAX_CONTAINER_DEPTH: Integer

        MAX_STRING_LENGTH: Integer

        INT64_MIN: Integer

        UINT16_MAX: Integer

        UINT32_MAX: Integer

        UINT64_MAX: Integer

        def self?.ruby_to_object: (
          top val,
          ?object: LibDDWAF::Object?,
          ?allocator: ::FFI::Pointer,
          ?top_obj: LibDDWAF::Object,
          ?current_depth: ::Integer,
          ?truncate: bool
        ) -> LibDDWAF::Object

        def self?.array_to_object: (
          LibDDWAF::Object object,
          ::Array[untyped] array,
          ::FFI::Pointer allocator,
          top_obj: LibDDWAF::Object,
          current_depth: ::Integer,
          ?truncate: bool
        ) -> LibDDWAF::Object

        def self?.hash_to_object: (
          LibDDWAF::Object object,
          ::Hash[untyped, untyped] hash,
          ::FFI::Pointer allocator,
          top_obj: LibDDWAF::Object,
          current_depth: ::Integer,
          ?truncate: bool
        ) -> LibDDWAF::Object

        def self?.json_to_object: (LibDDWAF::Object object, JSONString json, ::FFI::Pointer allocator) -> LibDDWAF::Object

        def self?.string_to_object: (LibDDWAF::Object object, ::String string, ::FFI::Pointer allocator, top_obj: LibDDWAF::Object, ?truncate: bool) -> LibDDWAF::Object

        def self?.container_size_limit: (::Integer current_depth) -> ::Integer

        def self?.object_to_ruby: (LibDDWAF::Object obj) -> WAF::opaque

        def self?.object_to_string: (LibDDWAF::Object obj) -> ::String
      end
    end
  end
end
