module Datadog
  module AppSec
    module WAF
      class HandleBuilder
        OBFUSCATOR_CONFIG_PATH: ::String

        @builder_ptr: ::FFI::Pointer

        def initialize: (?obfuscator: ::Hash[::Symbol, ::String?]) -> void

        def finalize!: () -> void

        def build_handle: () -> Handle

        def add_or_update_config: (WAF::input config, path: ::String) -> ConfigurationResult

        def remove_config_at_path: (::String path) -> bool

        private

        def configure_obfuscator: (::Hash[::Symbol, ::String?] obfuscator) -> void

        def ensure_pointer_presence!: () -> void
      end
    end
  end
end
