module Datadog
  module AppSec
    module WAF
      class HandleBuilder
        OBFUSCATOR_CONFIG_PATH: ::String

        @builder_ptr: ::FFI::Pointer
        @limits: ::Hash[::Symbol, ::Integer]

        def initialize: (?limits: ::Hash[::Symbol, ::Integer?], ?obfuscator: ::Hash[::Symbol, ::String?]) -> void

        def finalize!: () -> void

        def build_handle: () -> Handle

        def add_or_update_config: (WAF::input config, path: ::String) -> WAF::opaque

        def remove_config_at_path: (::String path) -> bool

        private

        def normalize_limits: (::Hash[::Symbol, ::Integer?] limits) -> ::Hash[::Symbol, ::Integer]

        def configure_obfuscator: (::Hash[::Symbol, ::String?] obfuscator) -> void

        def ensure_pointer_presence!: () -> void
      end
    end
  end
end
